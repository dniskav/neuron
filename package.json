{
  "name": "@dniskav/neuron",
  "version": "0.3.2",
  "description": "Minimal neural network from scratch — neuron, layer, network, backpropagation, classical ML, unsupervised, generative models, autograd. No dependencies.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "neural-network",
    "machine-learning",
    "backpropagation",
    "typescript"
  ],
  "author": "dniskav",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dniskav/neuron.git"
  },
  "homepage": "https://github.com/dniskav/neuron#readme",
  "bugs": {
    "url": "https://github.com/dniskav/neuron/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
